# Copie para .env apenas para uso local; nunca publique este arquivo com credenciais reais.
PORT=3000
NODE_ENV=development
ADMIN_EMAIL=admin@joinha.local
ADMIN_PASSWORD=
JWT_SECRET=
# URL pública canônica (opcional; usada em robots.txt/sitemap.xml). Ex.: https://www.seudominio.com.br
SITE_URL=
# Só preencha se a API for acessada por um frontend em outro domínio. Separe várias origens por vírgula.
FRONTEND_ORIGIN=
# Opcional: caminho persistente para SQLite.
DB_FILE=./server/joinha.sqlite
